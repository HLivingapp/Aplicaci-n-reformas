# Copia este archivo como .env.local (en local) o crea estas variables en Vercel.
# Sin ellas la app funciona en modo demostración (datos en el navegador).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: solo en el servidor. Nunca la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Nombre que aparece en la página de inicio
NEXT_PUBLIC_NOMBRE_EMPRESA=Human Living Reformas

# Secreto para la tarea diaria que vuelve a comprobar el REA de los reformistas (Vercel Cron lo envía solo).
# Pon una cadena larga y aleatoria. Nunca la subas al repositorio.
CRON_SECRET=
